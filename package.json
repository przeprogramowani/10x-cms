    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "4.21.2",
    "jquery": "3.7.1",
    "jquery-ui-dist": "1.13.2",
    "knex": "3.1.0",
    "multer": "1.4.5-lts.1",
    "sqlite3": "5.1.7",
    "superagent": "10.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "22.14.1",
    "chai": "4.3.4",
    "mocha": "8.4.0",
    "nodemon": "^3.0.2",
