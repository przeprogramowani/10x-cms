{
  "name": "10x-cms",
  "version": "1.0.0",
  "type": "module",
  "description": "A modern Content Management System built with performance and scalability in mind",
  "main": "index.ts",
  "scripts": {
    "start": "tsx index.ts",
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
